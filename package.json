{
  "name": "ganaderia-jr-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prototipo de aplicación web progresiva para la trazabilidad bovina y el seguimiento productivo de la Ganadería JR",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verificar:supabase": "node --env-file=.env.local scripts/verificar-supabase.mjs",
    "iconos": "pwa-assets-generator"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "dexie": "4.4.5",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3"
  }
}
