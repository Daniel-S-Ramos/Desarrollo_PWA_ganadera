# Copie este archivo como .env.local y complete los valores desde el panel de Supabase
# (Project Settings > API). La clave publicable es pública por diseño: la seguridad
# la imponen las reglas a nivel de fila, no el secreto de esta clave.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Cuenta de prueba para PI-04 (npm run prueba:pi-04). Solo la leen las pruebas de integración,
# nunca el código de la aplicación.
PRUEBAS_CORREO=pruebas@ganaderiajr.test
PRUEBAS_CONTRASENA=
